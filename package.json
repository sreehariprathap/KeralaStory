{
  "name": "kerala-story",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5000",
    "build": "npm run typecheck && npm run optimize:assets && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && npm run typecheck --workspace=@kerala-story/protocol && npm run typecheck --workspace=@kerala-story/simulation && npm run typecheck --workspace=@kerala-story/server",
    "test": "vitest run",
    "server:dev": "npm run dev --workspace=@kerala-story/server",
    "dev:all": "npm run server:dev & npm run dev",
    "preview": "vite preview --host 127.0.0.1",
    "generate:stunts": "tsx scripts/generate-stunt-sites.ts",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:menu-art": "node scripts/generate-menu-art.mjs"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.2",
    "@dimforge/rapier3d-compat": "0.19.2",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-malayalam": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@react-three/fiber": "9.7.0",
    "@react-three/rapier": "2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "6.1.1",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.0.1",
    "sharp": "^0.35.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
