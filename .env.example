# Static client endpoint; solo play needs no server.
VITE_MULTIPLAYER_URL=ws://127.0.0.1:2567
HOST=127.0.0.1
PORT=2567
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# Production requires exact HTTPS origins and a WSS endpoint.
# PUBLIC_WS_URL=wss://your-game-service.example

# NPC chat (server-side only; never expose these to the client)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
