{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "WebWorker"], "module": "ESNext", "moduleResolution": "Bundler",
    "skipLibCheck": true, "isolatedModules": true, "verbatimModuleSyntax": true, "noEmit": true,
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "types": []
  },
  "include": ["src-sw", "src/pwa/assetCache.ts"]
}
